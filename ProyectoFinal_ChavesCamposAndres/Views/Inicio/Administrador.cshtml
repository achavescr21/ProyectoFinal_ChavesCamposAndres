@{
    ViewData["Title"] = "Panel administrativo";
}
<h1>Panel administrativo</h1>
<p>Selecciona la información académica que necesitas gestionar.</p>
<section class="opcion">
    <h2>Carreras</h2>
    <p>Registro y mantenimiento de carreras universitarias.</p>
    <a class="boton" asp-controller="Carreras" asp-action="Index">
        Gestionar carreras
    </a>
</section>
<section class="opcion">
    <h2>Cursos</h2>
    <p>Registro de cursos y asociación con carreras.</p>
    <a class="boton" asp-controller="Cursos" asp-action="Index">
        Gestionar cursos
    </a>
</section>