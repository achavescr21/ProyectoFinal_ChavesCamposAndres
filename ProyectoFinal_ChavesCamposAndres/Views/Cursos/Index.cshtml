@model IEnumerable<Curso>
@{
    ViewData["Title"] = "Cursos";
}
<h1>Cursos</h1>
<a class="boton" asp-action="Crear">Nuevo curso</a>
@if (!Model.Any())
{
    <p>No hay cursos registrados.</p>
}
else
{
    <div class="tabla-contenedor">
        <table>
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Curso</th>
                    <th>Créditos</th>
                    <th>Carrera</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var curso in Model)
                {
                    <tr>
                        <td>@curso.Codigo</td>
                        <td>@curso.Nombre</td>
                        <td>@curso.Creditos</td>
                        <td>@curso.Carrera?.Nombre</td>
                        <td>
                            <a class="enlace" asp-action="Editar"
                               asp-route-id="@curso.Id">Editar</a>

                            <a class="enlace" asp-action="Eliminar"
                               asp-route-id="@curso.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}